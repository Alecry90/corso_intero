define('live-sql/components/terms-conditions/TermsText',["require","exports","preact/jsx-runtime"],(function(require,e,r){"use strict";Object.defineProperty(e,"__esModule",{value:!0});e.default=()=>(0,r.jsxs)("div",{children:[(0,r.jsx)("p",{children:'PLEASE SCROLL DOWN AND READ ALL OF THE FOLLOWING TERMS OF USE CAREFULLY. THIS IS A LEGAL AGREEMENT ("AGREEMENT") BETWEEN YOU AND ORACLE AMERICA, INC. STATING THE TERMS AND CONDITIONS THAT GOVERN YOUR USE OF THE ORACLE FreeSQL SERVICE. IF YOU ARE ENTERING INTO THIS AGREEMENT ON BEHALF OF A COMPANY OR LEGAL ENTITY, YOU REPRESENT THAT YOU HAVE THE AUTHORITY TO BIND SUCH ENTITY TO THESE TERMS AND CONDITIONS, IN WHICH CASE THE TERMS "YOU" AND "YOUR" SHALL REFER TO SUCH ENTITY. BY CHECKING "I AGREE" AND THEN CLICKING "ACCEPT" OR BY USING THE ORACLE FreeSQL SERVICE, YOU ARE AGREEING TO ALL OF THE TERMS AND CONDITIONS STATED HEREIN. IF YOU DO NOT AGREE TO THESE TERMS, DO NOT CHECK "I AGREE," DO NOT CLICK "ACCEPT," AND DO NOT USE THE ORACLE FreeSQL SERVICE.'}),(0,r.jsx)("p",{children:(0,r.jsx)("b",{children:"A. Agreement Definitions"})}),(0,r.jsx)("p",{children:'"Oracle" refers to Oracle America, Inc. "You" and "your" refers to the individual or entity that has ordered the Oracle FreeSQL Service by having checked "I AGREE" and clicked "ACCEPT" during the order process.'}),(0,r.jsx)("p",{children:"The Oracle FreeSQL Service is an Oracle online community designed to promote the learning and usage of SQL and PL/SQL."}),(0,r.jsx)("p",{children:'The terms "Oracle FreeSQL Service" and the "Service(s)" mean the service offerings that Oracle makes available through this web portal, including any software (including Oracle Programs), technology platform and other materials that Oracle makes available as part of the Services for your access and use with the Service environment. The Oracle FreeSQL Service may be used for non-production purposes only. However, SQL Scripts made available on the Site are licensed to you under the terms set forth in Section C.'}),(0,r.jsx)("p",{children:'The term "Oracle Programs" refers to the software products owned or distributed by Oracle to which Oracle grants you access as part of the Services, including user guides, and any program updates provided as part of the Services. Oracle Programs do not include SQL Scripts.'}),(0,r.jsx)("p",{children:'The term "Your Users" means those individuals authorized by you or on your behalf to use the Services.'}),(0,r.jsx)("p",{children:'The term "Users" means any individual or entity authorized to use the Services.'}),(0,r.jsx)("p",{children:'The term "Your Applications" means all software programs, including SQL Scripts and the like, that you or any of Your Users create using the Services, including any source code for such programs.'}),(0,r.jsx)("p",{children:'The term "Your Content" means all software (other than Your Applications), data, and data files provided by you or any of Your Users and that reside on, or run on or through, your Service environment.'}),(0,r.jsx)("p",{children:'The term "SQL Script" shall mean those scripts identified as available for your use under the terms of this Agreement.'}),(0,r.jsx)("p",{children:'The term "Site" means the collection of Oracle web pages through which the Services are obtained.'}),(0,r.jsx)("p",{children:'The term "Submissions" means any materials submitted to the Site by you.'}),(0,r.jsx)("p",{children:(0,r.jsx)("b",{children:"('B. Use Period')"})}),(0,r.jsx)("p",{children:"('This Agreement is effective upon your acceptance of this Agreement, and will continue until terminated in accordance with this Agreement (the \"Use Period\"). Oracle may, in its sole discretion, at any time discontinue providing or limit access to the Site, any areas of the Site or materials provided on or through the Site. You agree that Oracle may, in its sole discretion, at any time, terminate or limit your access to or use of the Site. Oracle will terminate or limit your access to or use of the Site if, under appropriate circumstances, you are determined to be an infringer of third party copyright rights. You agree that Oracle shall not be liable to you or any third-party for any termination or limitation of your access to or use of the Site.')"}),(0,r.jsx)("p",{children:(0,r.jsx)("b",{children:"C. Rights Granted by Oracle/Rights Granted by You"})}),(0,r.jsx)("p",{children:"For the duration of the Use Period, you have the nonexclusive, nontransferable, non-assignable, limited right to use the Services, subject to the terms of this Agreement, and solely for educational and experimental purposes. You may allow Your Users to use the Services for this purpose and you are responsible for Your Users' compliance with this Agreement."}),(0,r.jsx)("p",{children:"You acknowledge that Oracle has no delivery obligation and will not ship copies, or enable downloads, of any Oracle Programs as part of the Services. Third party technology that may be appropriate or necessary for use with some Oracle Programs will be specified by Oracle. Your right to use such third party technology is governed by the terms of the third party technology license agreement specified by Oracle and not under this Agreement."}),(0,r.jsx)("p",{children:"You do not acquire any license to use the Services, including any Oracle Programs to which Oracle provides you with access as part of the Services, in excess of the scope and/or duration of the Services defined in this Agreement. Upon the end of this Agreement or the Services hereunder, your right to access or use the Services and Oracle Programs, except the SQL Scripts, shall terminate."}),(0,r.jsx)("p",{children:"Oracle hereby grants to you a royalty-free, perpetual, irrevocable, worldwide, non-exclusive and fully sub-licensable right and license under Oracle's intellectual property rights to reproduce, modify, adapt, publish, translate, create derivative works from, distribute, publicly perform, publicly display and use SQL Scripts provided by Oracle 