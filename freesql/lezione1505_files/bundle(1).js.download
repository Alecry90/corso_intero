define('live-sql/components/worksheet-show-help-dialog/About',["require","exports","preact/jsx-runtime"],(function(require,e,t){"use strict";Object.defineProperty(e,"__esModule",{value:!0}),e.About=void 0;e.About=()=>(0,t.jsxs)("div",{children:[(0,t.jsxs)("p",{children:[(0,t.jsx)("a",{href:"#about",className:"oj-sm-margin-4x-bottom",children:" About Quick SQL"}),(0,t.jsx)("br",{}),(0,t.jsx)("a",{href:"#started",className:"oj-sm-margin-4x-bottom",children:" Getting Started"}),(0,t.jsx)("br",{}),(0,t.jsx)("a",{href:"#implementation",className:"oj-sm-margin-4x-bottom",children:" Creating the Database Objects"})]}),(0,t.jsx)("h6",{id:"about",children:"About Quick SQL"}),(0,t.jsxs)("div",{style:{whiteSpace:"pre-line"},children:[(0,t.jsx)("p",{children:"Quick SQL provides a quick way to generate the SQL required to create a relational data model from an indented text document. This tool is designed to reduce the time and effort required to create SQL tables, triggers, and index structures. This tool is not designed to be a replacement for data modeling, it is simply a quick way to develop a script for simple tables and views. Once the SQL is generated it can be tweaked and expanded upon."}),(0,t.jsx)("p",{children:"Top Use Cases"}),(0,t.jsx)("li",{children:"Quickly create robust data models"}),(0,t.jsx)("li",{children:"Easily generate random data"}),(0,t.jsx)("li",{children:"Learn SQL create table, select, insert, index, trigger, PL/SQL package, and view syntax using provided examples"})]}),(0,t.jsx)("h6",{id:"started",children:"Getting Started"}),(0,t.jsxs)("div",{style:{whiteSpace:"pre-line"},children:[(0,t.jsx)("p",{children:"Enter parent table names without any indention. Enter table columns with a uniform indention of 2 or more spaces. Generally it is best to not specify primary keys, the system will generate them for you. Parent child relationships are created simply by indenting child tables under parent tables."}),(0,t.jsx)("p",{children:'Datatypes typically default to VARCHAR2, if you want a column of a different datatype add a space NUM, INT, DATE to the end of a column name. Based on the english text contained in the column name, and in the absence of any datatype specified the system will make educated deductions for some column names. For example, if the column name contains the word DATE then it will be a date data type, or if the column name contains the word NUMBER or NUM then it will be a number data type. If you want to specify a specific VARCHAR2 length enter VCn where "n" is the length of the VARCHAR2. Click the Syntax button to show available syntax. Object names will be automatically formatted, replacing spaces with underscores, so you can use spaces in column and table names.'}),(0,t.jsx)("p",{children:'Click the Settings button to view many generation options. You can automatically add "Who Columns", e.g. who created or last updated a given row and when. You can add a row sequence column that automatically increments by one on each row update. A row sequence can be useful to simplify lost update detection. A PL/SQL API can also be generated which provides a package per table and provides procedures to query, insert, update, and delete rows.'})]}),(0,t.jsx)("h6",{id:"implementation",children:"Creating the Database Objects"}),(0,t.jsx)("div",{style:{whiteSpace:"pre-line"},children:(0,t.jsx)("p",{children:"Once you have completed entering the Quick SQL Shorthand and applied the appropriate settings, you are ready to use the SQL to create the database objects, and potentially populate the tables with random data. You can click Copy to Worksheet to have your SQL copied to the SQL Worksheet where you can edit and run it. Please note that if you resulting SQL is greater than 30k, the Copy to Worksheet button will be disabled and you will need to use an alternate method to run your SQL. Alternatively, you can click Save Script where your can name save it as a private script for future editing and execution. Lastly, you can click [Download] to download your resulting SQL to a file."})})]})}));
