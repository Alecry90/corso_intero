define('css!oj-dbt-shuttle/oj-dbt-shuttle-styles',[],function(){});
define("text!oj-dbt-shuttle/oj-dbt-shuttle-view.html",[],(function(){return'\x3c!--\n  Copyright (c) 2015, 2019, Oracle and/or its affiliates.\n  The Universal Permissive License (UPL), Version 1.0\n--\x3e\n<div class="shuttle__container oj-flex oj-sm-flex-direction-row oj-sm-flex-wrap-nowrap">\n    <div class="oj-flex-item oj-sm-flex-1 oj-flex oj-sm-flex-direction-column oj-sm-flex-wrap-nowrap">\n        <oj-label class="oj-sm-flex-0">\n            <oj-bind-text value="[[ optionsLabel ]]"></oj-bind-text>\n        </oj-label>\n        <div class="shuttle__column oj-sm-flex-1 oj-flex">\n            <oj-list-view class="shuttle__list oj-flex-item oj-sm-flex-1"\n                :id="[[ \'options-list-\' + uniqueId ]]"\n                data="[[ optionsDataProvider ]]"\n                gridlines.item="visible"\n                selection="{{ selectedOption }}"\n                selection-mode="multiple"\n                on-selection-changed="[[ onKeydownOptions ]]"\n                dnd.drag.items.data-types=\'["application/ojlistviewitems+json"]\'\n                dnd.drop.items.data-types=\'["application/ojlistviewitems+json"]\'\n                dnd.drag.items.drag-start="[[handleDragStart]]"\n                dnd.drop.items.drop="[[handleDropOptions]]">\n                <template slot="itemTemplate" data-oj-as="item">\n                    <span class="shuttle__list-item"\n                        :title="[[ item.data.label ]]"\n                        on-dblclick="[[ onDoubleClickOptions ]]"\n                        role="button"\n                        tabindex="0">\n                        <oj-bind-text value="[[ item.data.label ]]"></oj-bind-text>\n                    </span>\n                </template>\n            </oj-list-view>\n            <div class="oj-flex oj-sm-flex-initial">\n                <div class="oj-flex oj-sm-flex-direction-column oj-margin-horizontal oj-sm-flex-wrap-nowrap oj-sm-justify-content-center">\n                    <oj-button display="icons