pressed",description:"Table will be created compressed."},{name:"/insert NN",description:"Generate NN SQL INSERT statement(s) with random data, for example: /INSERT 20. (Maximum = 1000)"},{name:"/rest",description:"Generate REST enablement of the table using Oracle REST Data Services (ORDS)"},{name:"/select",description:"Generate SQL SELECT statement after generating data for each table"},{name:"/unique",description:"Generate table level unique constraint"}],e.ColumnDirerectives=[{name:"/idx, /index, /indexed",description:"Will create a non unique index on the associated column."},{name:"/unique",description:"Creates a unique constraint"},{name:"/check",description:"Creates a check constraint with comma or white space delimited values e.g. /check Yes, No"},{name:"/constant",description:"When generating data set this column to a constant value. For example /constant NYC."},{name:"/default",description:"Adds default value if the column is null"},{name:"/values",description:"Comma separated list of values to use when generating data. For example /values 1, 2, 3, 4 or /values Yes, No."},{name:"/upper",description:"Forces column values to upper case"},{name:"/lower",description:"Forces column values to lower case"},{name:"/nn, /not null",description:"Adds a not null constraint on the column"},{name:"/between",description:"Adds a between check constraint on the column, for example /between 1 and 100"},{name:"/hidden, /invisible",description:"Hidden columns are not displayed using select * from table."},{name:"/references, /reference, /fk",description:"Foreign key references e.g. /references table_name. Note you can reference tables that are not part of your model."},{name:"/pk",description:"Identifies column as the primary key of the table. It is recommended not manually specify primary keys and let this app create primary key columns automatically."},{name:"--, [ comments ]",description:"Enclose comments using square brackets or using dash dash syntax"}],e.Setting=[{setting:"APEX",description:"This setting controls the syntax generated to support audit columns.  Specifically if audit columns are enabled triggers are generated to maintain the user creating a row and the user last updating a row.  When enabled the following function is used:<pre>coalesce(sys_context('APEX$SESSION','APP_USER'),user)</pre>When not enabled the following function is used:<pre>user</pre>",example:"# apex: true",default:"false"},{setting:"API",description:"Generate PL/SQL APIs on all tables for create, insert, update, delete and query.",example:"# api: true",default:"false"},{setting:"AUDITCOLS",description:"Adds an additional created, created_by, updated and updated_by columns to every table created.",example:"# auditcols: true",default:"false"},{setting:"COMPRESS",description:"When enabled creates all tables compressed. Default is not compressed.",example:"# compress: true",default:"false"},{setting:"CREATEDBYCOL",description:"When Audit Columns are enabled the default column used to track the user who created a row is CREATED_BY. Use this setting to override default audit column name.",example:'# createdByCol: "created_by_user"',default:"created_by"},{setting:"CREATEDCOL",description:"When Audit Columns are enabled the default column used to track the user who created a row is CREATED. Use this setting to override default audit column name.",example:'# createdCol: "created_date"',default:"created"},{setting:"DATE",description:"By default all DATE columns created using the Oracle DATE datatype. Use this setting to override this default. Valid values are:<br /><strong>date, timestamp, timestamp with time zone,TSWTZ, timestamp with local time zone, TSWLTZ.</strong>",example:"# compress: true",default:"false"},{setting:"DB",description:"Specifies the database version the syntax should be compatible with. Valid values are:<br /><strong>11g, 12c, 19c, 21c</strong>",example:'# db: "19c"',default:"19c"},{setting:"DROP",description:"Include SQL commands to drop each database object created.",example:"# drop: true",default:"false"},{setting:"LANGUAGE",description:"Generate data used for insert statements using this language. The default is English. Supported languages include:<br /><strong>EN, DE, KO, JA</strong>",example:'# language: "EN"',default:"EN"},{setting:"LONGVC",description:"Allow longer identifiers to be used for database object names. Longer identifiers allow the maximum length a VARCHAR2 column datatype will be 32767 characters. When not set the maximum length of a VARCHAR2 column datatype will be 4000 characters.",example:"# longVC: true",default:"false"},{setting:"OVERRIDESETTINGS",description:"When enabled all application settings set via the user interface console are ignored and only settings set in the script will be used.",example:"# overrideSettings: true",default:"false"},{setting:"PK",description:"Determines how the primary key will be set. Primary keys can be set using SYS_GUID, identity column or sequence. Valid values include:<br /><strong>guid, seq, identity, none</strong>",example:'# PK: "identity"',default:"identity"},{setting:"PREFIX",description:"Database object prefix. An underscore will be appended if not provided.",example:'# prefix: "foo"',default:""},{setting:"PREFIXPKWITHTNAME",description:"Prefix primary key database table columns with name of table. For example the primary key of the EMPLOYEE table would be EMPLOYEE_ID. Without setting the name of implicitly created primary key columns will be ID.",example:"# prefixPKwithTname: true",default:"false"},{setting:"GENPK",description:"Automatically generate an ID primary key column for each table.",example:"# genPK: false",default:"true"},{setting:"RESETSETTINGS",description:"Resets all application settings to default values. When included all application settings currently active for your session will be ignored.",example:"# resetsettings",default:""},{setting:"ROWKEY",description:"For each table created add a ROW_KEY column that generates an alphanumeric identifier. Values of the ROW_KEY column will be set by generated database table trigger logic.",example:"# rowkey: true",default:"false"},{setting:"TENANTID",description:"For each table add a TENANT_ID column to support mutil-tenant applications. The value of this column is simply added to the table, maintaining this value will need to be provided by the developer.",example:"# tenantID: true",default:"false"},{setting:"ROWVERSION",description:"For each table generated add a ROW_VERSION column that increments by 1 for each update. When enabled database table trigger logic will be generated to increment row versions on update.",example:"# rowVersion: true",default:"false"},{setting:"SCHEMA",description:"Prefix object names with a schema name. The default is no schema prefix for object names.",example:'# schema: "scott"',default:""},{setting:"SEMANTICS",description:"You can choose no column semantics, or BYTE or CHAR semantics.<br /><strong>varchar2(4000), varchar2(4000 byte), varchar2(4000 char)</strong>",example:'# semantics: "char"',default:""},{setting:"UPDATEDBYCOL",description:"When enabling audit columns use this setting to override default audit column name.",example:'# updatedByCol: "updated_by_user"',default:"updated_by"},{setting:"UPDATEDCOL",description:"When enabling audit columns use this setting to override default audit column name.",example:'# updatedCol: "updated_dt"',default:"updated"},{setting:"VERBOSE",description:"Automatically generate an ID primary key column for each table.",example:"# genPK: false",default:"true"}]}));
