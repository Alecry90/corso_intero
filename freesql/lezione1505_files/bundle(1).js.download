define('text!live-sql/components/dbt-code-viewer/component.json',[],function () { return '{\n    "name": "dbt-code-viewer",\n    "version": "1.1.0",\n    "jetVersion": ">=8.0.0",\n    "properties": {\n        "content": {\n            "description": "Code to highlight",\n            "type": "string|Array<string>",\n            "value": ""\n        },\n        "language": {\n            "description": "Language",\n            "type": "string",\n            "value": "text/plain"\n        },\n        "colorizerType": {\n            "description": "The library that will be used to highlight the content",\n            "type": "string",\n            "value": "MONACO",\n            "enumValues": [ "CODE_MIRROR", "MONACO" ]\n        },\n        "inline": {\n            "description": "Wether or not the element to return will be inline",\n            "type": "boolean",\n            "value": false\n        },\n        "copyToClipboardEnabled": {\n            "description": "Wether or not the component will have a copy-to-clipboard button",\n            "type": "boolean",\n            "value": false\n        },\n        "maxDisplaySize": {\n            "description": "Longest content size to be displayed, when set to 0 no limit will be set",\n            "type": "number",\n            "value": 50000\n        },\n        "size": {\n            "description": "Wether or not the Code Viewer will have the same size as its parent or not",\n            "type": "string",\n            "value": "INHERIT",\n            "enumValues": [ "INHERIT", "DEFINED_BY_CONTENT" ]\n        },\n        "actions": {\n            "description": "List of action descriptions",\n            "type": "Array<Object>"\n        },\n        "actionsPosition": {\n            "description": "The actions bar position",\n            "type": "string",\n            "value": "RIGHT",\n            "enumValues": [ "TOP", "RIGHT", "BOTTOM", "LEFT" ]\n        },\n        "simpleTheme": {\n            "description": "The Monaco theme. If this param is not provided, the component will use the theme selected in Preferences. Note: this property will be removed in the future.",\n            "type": "string",\n            "enumValues": [ "vs", "vs-snippet", "vs-dark", "hc-black" ]\n        }\n    },\n    "methods": {\n        "setContent": {\n            "description": "Receives a new content, colorizes it and displays it",\n            "internalName": "setContent",\n            "params": [\n                {\n                    "name": "content",\n                    "description": "Code to highlight",\n                    "type": "string"\n                }\n            ]\n        },\n        "getContent": {\n            "description": "Retrieves the full code viewer content",\n            "internalName": "getContent"\n        },\n        "setLanguage": {\n            "description": "Receives a new language, colorizes it and displays it",\n            "internalName": "setLanguage",\n            "params": [\n                {\n                    "name": "language",\n                    "description": "Content language",\n                    "type": "string"\n                }\n            ]\n        },\n        "setLoadingState": {\n            "description": "Receives a boolean to show or hide loading spinner",\n            "internalName": "setLoadingState",\n            "params": [\n                {\n                    "name": "isLoading",\n                    "description": "True to show the spinner, false to hide it",\n                    "type": "boolean"\n                }\n            ]\n        },\n        "setTheme": {\n            "description": "Receives a theme and sets it",\n            "internalName": "setTheme",\n            "params": [\n                {\n                    "name": "theme",\n                    "description": "The Monaco theme (\'vs\', \'vs-dark\' or \'hc-black\')",\n                    "type": "string"\n                }\n            ]\n        },\n        "setOptions": {\n            "description": "Receives a new set of options, colorizes it and displays it",\n            "internalName": "setOptions",\n            "params": [\n                {\n                    "name": "options",\n                    "description": "Set of options",\n                    "type": "Object"\n                }\n            ]\n        }\n    }\n}\n';});


