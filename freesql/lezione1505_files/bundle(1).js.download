define("text!oj-dbt-data-grid/oj-dbt-data-grid-view.html",[],(function(){return'\x3c!-- header.column.sortable="[[ $properties.header.column.sortable ]]" --\x3e\n<div\n    :id="[[ $data.elementId + \'-root\' ]]"\n    class="oj-flex oj-sm-flex-direction-column oj-sm-flex-1 oj-dbt-data-grid-off-canvas-root rest-grid-root oj-offcanvas-outer-wrapper"\n    style="height: 100%; ">\n    <div\n        :id="[[ $data.elementId + \'-content-0\' ]]"\n        class="oj-dbt-data-grid-off-canvas-content oj-dbt-data-grid-off-canvas-content-0 oj-flex oj-sm-flex-direction-column oj-sm-flex-1">\n        <oj-data-grid\n            :id="[[ $data.elementId + \'-grid\' ]]"\n            class="oj-sm-flex-1"\n            banding-interval="[[ $data.bandingInterval ]]"\n            cell="[[ $data.cell ]]"\n            current-cell="{{ $data.currentCell }}"\n            data="[[ proxyDataGridProvider ]]"\n            dnd="[[ $properties.dnd ]]"\n            edit-mode="{{ $data.calculatedEditMode }}"\n            gridlines="[[ $data.gridlines ]]"\n            header.column.class-name="[[ getHeaderClassName ]]"\n            header.column.label="[[ $properties.header.column.label ]]"\n            header.column.renderer="[[ $properties.header.column.renderer ]]"\n            header.column.resizable="[[ $properties.header.column.resizable ]]"\n            header.column.sortable="[[ \'auto\' ]]"\n            header.column.style="[[ $properties.header.column.style ]]"\n            header.row.class-name="[[ getHeaderClassName ]]"\n            header.row.label="[[ $properties.header.label ]]"\n            header.row.renderer="[[ $properties.header.row.renderer ]]"\n            header.row.resizable="[[ $properties.header.row.resizable ]]"\n            header.row.sortable="[[ $properties.header.row.sortable ]]"\n            header.row.style="[[ getHeaderRowStyle || $properties.header.row.style ]]"\n            header.row-end="[[ $properties.header.rowEnd ]]"\n            header.column-end="[[ $properties.header.columnEnd ]]"\n            scroll-policy="[[ $data.scrollPolicy ]]"\n            scroll-policy-options="[[ $data.scrollPolicyOptions ]]"\n            scroll-position="{{ $data.scrollPosition }}"\n            scroll-to-key="[[ $data.scrollToKey ]]"\n            selection="{{ $data.selection }}"\n            selection-mode="[[ $data.selectionMode ]]"\n            translations="[[ $data.translations ]]"\n            on-oj-sort="[[handleSort]]"\n            on-oj-before-edit="[[handleBeforeEdit]]"\n            on-oj-before-edit-end="[[ handleEditEnd ]]"\n            on-oj-sort-request="[[handleSortRequest]]">\n            <oj-menu\n                :id="[[ $data.elementId + \'-menu\' ]]"\n                slot="contextMenu"\n                on-oj-menu-action="[[ $data.contextMenuAction ]]"\n                on-oj-before-open="[[ $data.contextMenuBeforeOpen ]]"\n                aria-label="oj-dbt-data-grid-context-menu">\n           </oj-menu>\n        </oj-data-grid>\n        <oj-dialog\n            :id="[[ $data.elementId + \'-count-rows-dialog\' ]]"\n            class="oj-dbt-data-grid-count-rows-dialog"\n            initial-visibility=\'hide\'\n            on-oj-before-open="[[ $data.countRowsData().beforeOpenEvent]]"\n            on-oj-resize="[[ $data.countRowsData().resizeEvent ]]"\n            dialog-title="[[ $data.countRowsData().translation_count_rows_view_popup_title ]]">\n            <div slot="body" class="rest-grid-count-rows-view-body" style="min-height: 48px;">\n                <oj-bind-if test="[[ $data.countRowsData().isLoading() ]]">\n                    <div :class="loadingIcon" style="text-align: center;">\n                        <i class="oj-icon oj-datagrid-loading-icon"></i>\n                    </div>\n                </oj-bind-if>\n                <oj-bind-if test="[[ !$data.countRowsData().isLoading() ]]">\n                    <div class="oj-dbt-data-grid-count-rows-dialog-info" style="text-align: center;">\n                        <span><oj-bind-text value="[[ $data.countRowsData().count ]]"></oj-bind-text></span>\n                    </div>\n                </oj-bind-if>\n            </div>\n            <div slot="footer">\n                 <oj-button chroming="borderless" on-oj-action="[[ $data.countRowsData().copyClicked]]">\n                    <span slot=\'startIcon\' class="oj-ux-ico-copy"></span>\n                    <span><oj-bind-text value="[[ $data.countRowsData().translation_count_rows_copy_result ]]"></oj-bind-text></span>\n                </oj-button>\n                <oj-button chroming="borderless" on-oj-action="[[ $data.countRowsData().okClicked ]]">\n                    <span><oj-bind-text value="[[ $data.countRowsData().translation_ok_button ]]"></oj-bind-text></span>\n                </oj-button>\n            </div>\n        </oj-dialog>\n        \x3c!-- ensure dialog displays body --\x3e\n        <style>\n            .oj-dialog-content.oj-dialog-default-content > div {\n                 min-height: 48px;\n            }\n        </style>\n        <oj-dialog\n            :id="[[ $data.elementId + \'-copy-failed-dialog\' ]]"\n            class="oj-dbt-data-grid-copy-failed-dialog"\n            initial-visibility=\'hide\'\n            on-oj-before-open="[[ $data.copyFailedData().beforeOpenEvent]]"\n            dialog-title="[[ $data.res.copy_to_clipboard_copy_failed_popup_title ]]">\n            <div slot="body" class="oj-dbt-data-grid-count-rows-view-body">\n                <div class="oj-dbt-data-grid-copy-to-clipboard-failed-info">\n                    <span aria-hidden="true" class="fa fa-exclamation-circle"></span><span>&nbsp;<oj-bind-text value="[[ $data.res.copy_to_clipboard_copy_failed_message ]]"></oj-bind-text></span>\n                    <oj-bind-if test="[[ $data.copyFailedData().errorMessage ]]" >\n                        <br>\n                        <span aria-hidden="true" class=""><oj-bind-text value="[[ $data.copyFailedData().errorMessage ]]"></oj-bind-text></span>\n                    </oj-bind-if>\n                </div>\n            </div>\n            <div slot="footer">\n               <oj-button chroming="borderless" on-oj-action="[[ $data.copyFailedData().cancelClicked ]]">\n                   <span><oj-bind-text value="[[ $data.res.cancel_button ]]"></oj-bind-text></span>\n               </oj-button>\n           </div>\n        </oj-dialog>\n    </div>\n    <div :id="[[ $data.elementId + \'-drawer-0\' ]]" class="oj-offcanvas-end oj-dbt-data-grid-off-canvas-drawer-0" >\n        <div class="oj-offcanvas-outer-wrapper oj-sm-flex-1 oj-flex oj-sm-flex-direction-column oj-panel oj-panel-border-radius-0 oj-sm-padding-0" style="height: 100%;" >\n            <div :id="[[ $data.elementId + \'-content-1\' ]]" class="oj-dbt-data-grid-off-canvas-content-1" style="height: 100%; " >\n                <oj-bind-if test="[[ $data.offCanvasStack[0]?.module ]]">\n                    <oj-module class="oj-flex oj-sm-flex-direction-column oj-sm-flex-wrap-nowrap" style="height: 100%; " config="[[ $data.offCanvasStack[0].module ]]"></oj-module>\n                </oj-bind-if>\n            </div>\n            <div :id="[[ $data.elementId + \'-drawer-1\' ]]" class="oj-dbt-data-grid-off-canvas-drawer-1 oj-offcanvas-end" >\n                <div class="oj-offcanvas-outer-wrapper oj-sm-flex-1 oj-flex oj-sm-flex-direction-column oj-panel oj-panel-border-radius-0 oj-sm-padding-0" style="height: 100%;" >\n                    <div :id="[[ $data.elementId + \'-content-2\' ]]" class="oj-dbt-data-grid-off-canvas-content-2" style="height: 100%; " >\n                        <oj-bind-if test="[[ $data.offCanvasStack[1]?.module ]]">\n                            <oj-module class="oj-flex oj-sm-flex-direction-column oj-sm-flex-wrap-nowrap" style="height: 100%; " config="[[ $data.offCanvasStack[1].module ]]"></oj-module>\n                        </oj-bind-if>\n                    </div>\n                    <div :id="[[ $data.elementId + \'-drawer-2\' ]]" class=