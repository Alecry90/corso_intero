w.w3.org%2FGraphics%2FSVG%2F1.1%2FDTD%2Fsvg11.dtd%22%3E%3Csvg%20version%3D%221.1%22%20id%3D%22Layer_1%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20xmlns%3Axlink%3D%22http%3A%2F%2Fwww.w3.org%2F1999%2Fxlink%22%20x%3D%220px%22%20y%3D%220px%22%20%20width%3D%2224px%22%20height%3D%228px%22%20viewBox%3D%220%200%2024%208%22%20enable-background%3D%22new%200%200%2024%208%22%20xml%3Aspace%3D%22preserve%22%3E%3Cg%20opacity%3D%220.8%22%3E%20%3Cpolygon%20fill%3D%22%23FFFFFF%22%20points%3D%2212%2C2%2016%2C6%208%2C6%20%20%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E\");\n}\n.dbt-splitter__gutter--horizontal > .dbt-splitter__gutter-button--right {\n    background-image: url(\"data:image/svg+xml;charset=US-ASCII,%3C%3Fxml%20version%3D%221.0%22%20encoding%3D%22utf-8%22%3F%3E%3C!DOCTYPE%20svg%20PUBLIC%20%22-%2F%2FW3C%2F%2FDTD%20SVG%201.1%2F%2FEN%22%20%22http%3A%2F%2Fwww.w3.org%2FGraphics%2FSVG%2F1.1%2FDTD%2Fsvg11.dtd%22%3E%3Csvg%20version%3D%221.1%22%20id%3D%22Layer_1%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20xmlns%3Axlink%3D%22http%3A%2F%2Fwww.w3.org%2F1999%2Fxlink%22%20x%3D%220px%22%20y%3D%220px%22%20%20width%3D%2224px%22%20height%3D%228px%22%20viewBox%3D%220%200%2024%208%22%20enable-background%3D%22new%200%200%2024%208%22%20xml%3Aspace%3D%22preserve%22%3E%3Cg%20opacity%3D%220.8%22%3E%20%3Cpolygon%20fill%3D%22%23FFFFFF%22%20points%3D%2212%2C6%208%2C2%2016%2C2%20%20%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E\");\n}\n\n.dbt-splitter__gutter-button {\n    background-color: var(--gutter-button-color) !important;\n    background-position: 50% 50%;\n    padding: 0;\n    padding-inline: 0;\n    border: 0;\n    background-repeat: no-repeat;\n}\n.dbt-splitter__gutter-button--vertical {\n    inline-size: var(--gutter-size);\n    block-size: calc(var(--gutter-size) * 6);\n}\n.dbt-splitter__gutter-button--horizontal {\n    inline-size: calc(var(--gutter-size) * 6);\n    block-size: var(--gutter-size);\n}\n/** Responsive classes **/\n\n.dbt-splitter.is-responsive > .dbt-splitter__panel > .dbt-splitter__panel-content {\n    display: flex;\n    justify-content: space-between;\n    flex-flow: column;\n}\n.dbt-splitter.is-responsive,\n.dbt-splitter.is-responsive > .dbt-splitter__panel--active {\n    display: block;\n}\n.dbt-splitter.is-responsive + .dbt-splitter__controls {\n    padding-left: 5px;\n    display: flex;\n}\n.dbt-splitter.is-responsive > .dbt-splitter__panel--active {\n    inline-size: 100%;\n    block-size: 100%;\n}\n.dbt-splitter.is-responsive > .dbt-splitter__panel--hidden,\n.dbt-splitter.is-responsive > .dbt-splitter__panel > .dbt-splitter__gutter {\n    display: none;\n}\n\n/* */\n\n.dbt-splitter__errorMessage {\n    justify-self: center;\n    align-self: center;\n}\n\n.dbt-splitter__controls {\n    display: none;\n}\n.aligned-items {\n    display: flex;\n    align-items: end;\n    justify-content: end;\n    gap: 0.5rem;\n    padding-left: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n    padding-right: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n    margin-left: auto\n}\n\n.aligned-items-side-panel {\n    padding-left: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n    padding-right: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n}\n\n.loading {\n    height: 100%;\n}\n\n.library-full-size {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0,1fr));\n    gap: 1.3rem;\n}\n\n.library-side-panel {\n    display: grid;\n    grid-template-columns: repeat(1, minmax(0,1fr));\n    gap: 1.3rem;\n}\n\n.content-search-side-panel {\n    width: 100%;\n}\n\n.content-search-full-size {\n    width: 20vw;\n}\n\n.content-filter-active {\n    width: 15vw;\n    background-color: rgb(var(--oj-palette-neutral-rgb-50));\n}\n\n.content-filter-active-dark {\n    width: 15vw;\n    background-color: rgb(var(--oj-palette-neutral-rgb-170));\n}\n\n.content-filter-non-active {\n    width: 15vw;\n}\n\n.content-editor {\n    padding-left: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n    padding-right: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n}\n\n.empty-state {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    gap: 1rem;\n}\n\n.navigation-list-disable {\n    pointer-events: none;\n    cursor: default;\n}\n\n.panel-border-none {\n    border: 0px;\n}\n\n@media (min-width: 1550px) {\n    .library-full-size {\n        grid-template-columns: repeat(4, minmax(0,1fr));\n    }\n}\n\n@media (max-width: 1000px) {\n    .library-full-size {\n        grid-template-columns: repeat(2, minmax(0,1fr));\n    }\n}\n\n@media (max-width: 500px) {\n    .library-full-size {\n        grid-template-columns: repeat(1, minmax(0,1fr));\n    }\n\n    .aligned-items {\n        display: flex;\n        flex-direction: column;\n        align-items: normal;\n        padding-left: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n        padding-right: calc(var(--oj-private-app-layout-web-padding) - 2 * var(--oj-core-spacing-1x));\n    }\n\n    .content-search-full-size {\n        width: 100%;\n    }\n}/* For browsers supporting -webkit-line-clamp */\n@supports (-webkit-line-clamp: 1) {\n\n    .action-card-description,\n    .action-card-title,\n    .action-card-created-by {\n        display: -webkit-box;\n        -webkit-box-orient: vertical;\n        overflow: hidden;\n    }\n\n    .action-card-description {\n        -webkit-line-clamp: 4;\n        height: 84px;\n    }\n\n    .action-card-title {\n        -webkit-line-clamp: 1;\n        height: 25px;\n    }\n\n    .action-card-created-by {\n        -webkit-line-clamp: 1;\n        height: 17px;\n    }\n}\n\n/* For browsers that don\'t support -webkit-line-clamp */\n@supports not (-webkit-line-clamp: 1) {\n\n    .action-card-description,\n    .action-card-title,\n    .action-card-created-by {\n        display: block;\n        overflow: hidden;\n        position: relative;\n        word-wrap: break-word;\n        text-overflow: ellipsis;\n    }\n\n    .action-card-description {\n        height: 84px;\n        line-height: 21px;\n        max-height: calc(4 * 21px);\n    }\n\n    .action-card-title {\n        height: 25px;\n    }\n\n    .action-card-created-by {\n        height: 17px;\n    }\n}.library-page__content-container {\n    overflow: auto;\n    position: relative;\n    min-height: 0;\n}\n\n/*\n    Putting height to 0 is to make the height only depending on the content with flex-grow:1 style \n    and to avoid having a second scroll that affects the footer\n*/\n.library-page__content-container.full-width {\n    height: 0;\n}oj-c-message-banner:not(.oj-complete) {\n  visibility: hidden;\n}\n\noj-c-message-banner {\n  display: block;\n}\n\noj-c-message-banner[hidden] {\n  display: none;\n}\ndbt-sql-worksheet {\n    width: 100%;\n    height: 100%;\n    background-color: var(--color-site-2);\n    flex: 1 1 auto;\n    min-height: 0px;\n    overflow: auto;\n}\n\ndbt-sql-worksheet #splitter_first {\n    overflow: hidden;\n}\n\ndbt-sql-worksheet oj-button.oj-disabled span.fam-is-success::after {\n    color: var(--color-site-2-2) !important;\n}\n\ndbt-sql-worksheet oj-button.oj-disabled span.fa-color-success {\n    color: var(--color-site-2-2) !important;\n}\n\ndbt-sql-worksheet span.oj-toolbar-separator {\n    height: 1.833em;\n    display: inline-block;\n    vertical-align: middle;\n    margin-left: 0.167em;\n    margin-right: 0.5em;\n}\n\n/* \n    - this is a work around to hide the empty submenu\n    - It\'s related to a JET bug\n    - A ticket is created to solve the bug by JET team\n    - Once the bug is solved we should remove this work around\n*/\n.open-recent-submenu {\n    visibility: hidden;\n}.dbt-panel {\n    display: block;\n    height: 100%;\n}\n\n.dbt-panel > * {\n    width: 100%;\n    height: 100%;\n}\n\n.dbt-panel__title {\n    margin: 0 10px 0 0;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    overflow: hidden;\n    max-width: 100%;\n}\n\n.dbt-panel__layout {\n    background-color: var(--oj-panel-bg-color);\n}\n\n.dbt-panel__apex-splitter-wrapper {\n    height: 100%;\n}\n\n.dbt-panel__tabbar[edge=top] {\n    border-top: 1px solid var( --color-site-2-1, #E5E6E6 );\n    border-bottom: 1px solid var( --color-site-2-1, #E5E6E6 );\n}\n\n.dbt-panel__tabbar-item {\n    flex: 0 !important; /* Override JET style */\n}\n\n.dbt-panel__tabbar-item--hidden {\n    position: absolute;\n    visibility: hidden;\n}\n\n.dbt-panel__switcher {\n    max-height: 100%;\n    overflow: hidden;\n}\n\n.dbt-panel__targets-container {\n    max-height: 100%;\n}\n\n.dbt-panel__module-container {\n    max-width: 100%;\n    max-height: 100%;\n}\n\n.dbt-panel__module-container > oj-module {\n    flex: 1\n}\n\n.dbt-panel__buttonset-title-controls-container {\n    max-width: 100%;\n}\n\n.dbt-panel__buttonset-title-container {\n    max-width: 100%;\n    flex-basis: auto;\n}\n\n.dbt-panel__buttonset-controls-container {\n    max-width: 100%;\n    flex-shrink: 0;\n    flex-basis: auto;\n    height: 36px;\n    overflow: hidden;\n    margin-left: auto;\n}\n\n.script-output__toolbar {\n    padding-left: 10px;\n    border-bottom: 1px solid var( --color-site-1-1 );\n}\n.code-playground {\n    width: 100%;\n    height: 100%;\n}\n\n.code-playground__layout {\n    height: inherit;\n    width: inherit;\n}\n\n.code-playground__toolbar-container {\n    border-bottom: 1px solid var( --color-site-1-1 );\n    width: 100% !important;\n}\n\n.code-playground__panels-container {\n    overflow: hidden;\n}\n\n.code-playground__apex-splitter-wrapper {\n    height: 100%;\n    width: 100%;\n}\n\n.code-playground__apex-splitter-wrapper:not( .embedded-playground * ) > * {\n    width: 100% !important;\n}\ndbt-bind-if {\n    display: inline-block;\n}\noj-dbt-shuttle:not( .oj-complete ) {\n  visibility: hidden;\n}\n\noj-dbt-shuttle {\n\tdisplay: block;\n\tmin-height: 150px;\n\twidth: 100%;\n}\n\n.shuttle__container  {\n\theight: inherit;\n}\n\n.shuttle__column {\n\t/* Calculation done by taking 17.5px of the label\'s height and 3.5px of the margin */\n\theight: calc(100% - 17.5px + 3.5px);\n}\n\n.shuttle__list {\n\tborder-width: 1px;\n\theight: 100%;\n\tmax-height: inherit;\n}\n\n.shuttle__list .oj-listview-item {\n\tpadding: 0px;\n}\n\n.shuttle__list-item {\n\tdisplay: block;\n\twidth: 100%;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n\twhite-space: nowrap;\n\tpadding: 7px;\n\tbox-sizing: border-box;\n}\n/* This file is where css selectors for the component go.\n   There will be hard coded properties and properties controlled by variables, for example\n\n   oj-dbt-data-grid .oj-dbt-data-grid-value-text {\n   color: var(--oj-dbt-data-grid-value-text-color);\n   display: inline-block;\n\t }\n*/\n\n:root {\n  --ojDbtDataGridUpdatedBorderColor:                     cornflowerblue;\n  --ojDbtDataGridCellUpdatedBorderColor:                 var(--ojDbtDataGridUpdatedBorderColor);\n  --ojDbtDataGridRowUpdatedHeaderBorderColor:            var(--ojDbtDataGridUpdatedBorderColor);\n  --ojDbtDataGridSingleRecViewItemUpdatedColor:          var(--ojDbtDataGridUpdatedBorderColor);\n     \n  --ojDbtDataGridNewBorderColor:                         darkseagreen;\n  --ojDbtDataGridCellNewBorderColor:                     var(--ojDbtDataGridNewBorderColor)  !important;\n  --ojDbtDataGridRowNewHeaderBorderColor:                var(--ojDbtDataGridNewBorderColor)  !important;\n  --ojDbtDataGridSingleRecViewItemNewColor:              var(--ojDbtDataGridNewBorderColor)  !important;\n\n  --ojDbtDataGridDeletedBorderColor:                     lightcoral;\n  --ojDbtDataGridCellDeletedBorderColor:                 var(--ojDbtDataGridDeletedBorderColor)  !important;\n  --ojDbtDataGridRowDeletedHeaderBorderColor:            var(--ojDbtDataGridDeletedBorderColor)  !important;\n  --ojDbtDataGridSingleRecViewItemDeletedColor:          var(--ojDbtDataGridDeletedBorderColor)  !important;\n\n  --ojDbtDataGridOffCanvasBackgroundColor:               #fcfcfc;\n  --ojDbtDataGridOffCanvasZIndex:                        10000;\n  --ojDbtDataGridOffCanvasMenuZIndex:                    10350;\n}\n\n/* ========================================================================== */\n\noj-dbt-data-grid:not(.oj-complete){\n  visibility: hidden;\n}\n\noj-dbt-data-grid{\n  display: flex;\n  flex-direction: column;\n\tmin-height: 100px;\n\tmin-width: 50px;\n  height: 100%;\n}\n\n.rest-grid-column-name {\n  text-transform: uppercase;\n  font-weight: bold;\n}\n\noj-db-rest-grid .oj-listview .oj-drop {\n  position: static;\n}\n\n.oj-dbt-data-grid-single-rec-view-entry .oj-listitemlayout-grid {\n  padding-top: calc(var(--oj-collection-list-cell-padding-vertical) / 2);\n  padding-bottom: calc(var(--oj-collection-list-cell-padding-vertical) / 2);\n}\n\nli.oj-dbt-data-grid-single-rec-view-item-updated {\n  border: 1px solid var(--ojDbtDataGridSingleRecViewItemUpdatedColor);\n}\n\n.oj-dbt-data-grid-single-rec-view-item-updated.oj-listview-item.oj-hover {\n  border-top: 1px solid var(--ojDbtDataGridSingleRecViewItemUpdatedColor);\n}\n\n/*\noj-dbt-data-grid-single-rec-\noj-dbt-data-grid-single-rec-\noj-dbt-data-grid-single-rec-\noj-dbt-data-grid-single-rec-\n*/\n/*\n.rest-grid-header {\n}\n*/\n\n.rest-grid-row-header {\n    border-width: 1px;\n    font-weight: bold;\n}\n\n.oj-dbt-data-grid-column-header {\n    width:10rem;\n    justify-content: flex-start;\n    text-transform: uppercase;\n    font-weight: bold;\n}\n\n.rest-grid-cell {\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.oj-dbt-data-grid-cell-null {\n  font-style: italic;\n}\n\n.oj-dbt-data-grid-cell-number .oj-text-field-readonly {\n  text-align: end;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.oj-dbt-data-grid-cell-text .oj-text-field-readonly {\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.oj-dbt-data-grid-edit-button {\n  background-color: var(--oj-collection-free-space-bg-color);\n}\n\n/* edit button in the cells visibility control */\ndiv.oj-datagrid-cell .oj-dbt-data-grid-edit-button {\n  display: none;\n  position: absolute;\n}\n\nhtml:not([dir=\"rtl\"]) div.oj-datagrid-cell .oj-dbt-data-grid-edit-button {\n  right: 0px;\n}\n\nhtml[dir=\"rtl\"] div.oj-datagrid-cell .oj-dbt-data-grid-edit-button {\n  left: 0px;\n}\n\n/* edit button in the cells visibility control*/\ndiv.oj-focus.oj-datagrid-cell .oj-dbt-data-grid-edit-button,\ndiv.oj-datagrid-cell:hover .oj-dbt-data-grid-edit-button {\n  display: block;\n  top: -2px;\n}\n/* no edit button if cell is in edit mode */\ndiv.oj-focus.oj-datagrid-cell-edit .oj-dbt-data-grid-edit-button {\n  display: none;\n}\n\n.oj-dbt-data-grid-small-width {\n  width: 30%;\n}\n\n.oj-dbt-data-grid-medium-width {\n  width: 50%;\n}\n\n.oj-dbt-data-grid-large-width {\n  width: 75%;\n}\n\n.oj-dbt-data-grid-small-width-auto {\n  min-width: 30%;\n  width: auto;\n  max-width: 100%;\n}\n\n.oj-dbt-data-grid-medium-width-auto {\n  min-width: 50%;\n  width: auto;\n  max-width: 100%;\n}\n\n.oj-dbt-data-grid-large-width-auto {  \n  min-width: 75%;\n  width: auto;\n  max-width: 100%;\n}\n\n.oj-dbt-data-grid-extra-large-width {\n  width: 90%;\n}\n\n.oj-dbt-data-grid-extra-large-width-auto {\n  min-width: 90%;\n}\n\n\n@media screen and (max-width: 767px) {\n\n  .oj-dbt-data-grid-small-width {\n    width: 100%;\n  }\n\n  .oj-dbt-data-grid-medium-width {\n    width: 100%;\n  }\n\n  .oj-dbt-data-grid-large-width {\n    width: 100%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width {\n    width: 100%;\n  }\n\n  .oj-dbt-data-grid-small-width-auto {\n    min-width: 100%;\n  }\n\n  .oj-dbt-data-grid-medium-width-auto {\n    min-width: 100%;\n  }\n\n  .oj-dbt-data-grid-large-width-auto {\n    min-width: 100%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width-auto {\n    min-width: 100%;\n  }\n}\n\n@media screen and (min-width: 768px) and (max-width: 1023px) {\n  \n  .oj-dbt-data-grid-small-width {\n    width: 50%;  \n  }\n  \n  .oj-dbt-data-grid-medium-width {\n    width: 60%;\n  }\n\n  .oj-dbt-data-grid-large-width {\n    width: 75%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width {\n    width: 95%;\n  }\n\n  .oj-dbt-data-grid-small-width-auto {\n    min-width: 50%;  \n  }\n  \n  .oj-dbt-data-grid-medium-width-auto {\n    min-width: 60%;\n  }\n\n  .oj-dbt-data-grid-large-width-auto {\n    min-width: 75%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width-auto {\n    min-width: 95%;\n  }\n\n}\n\n@media screen and (min-width: 1024px) {\n\n  .oj-dbt-data-grid-small-width {\n    width: 30%;\n  }\n\n  .oj-dbt-data-grid-medium-width {\n    width: 40%;\n  }\n\n  .oj-dbt-data-grid-large-width {\n    width: 50%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width {\n    width: 75%;\n  }\n\n  .oj-dbt-data-grid-small-width-auto {\n    min-width: 30%;\n  }\n\n  .oj-dbt-data-grid-medium-width-auto {\n    min-width: 40%;\n  }\n\n  .oj-dbt-data-grid-large-width-auto {\n    min-width: 50%;\n  }\n\n  .oj-dbt-panel-slider-extra-large-width-auto {\n    min-width: 75%;\n  }\n\n}\n\n/* Sort view slider css rules */\n\n.oj-dbt-data-grid-sort-view-body {\n    display: flex;\n    flex-direction: row;\n}\n\n.oj-dbt-data-grid-sort-view-body .oj-listview-item {\n  text-transform: uppercase;\n}\n\n.oj-dbt-data-grid-sort-view-order-buttons {\n  margin: auto;\n}\n\n.oj-dbt-data-grid-sort-view-available-list {\n  overflow: auto;\n}\n\n.oj-dbt-data-grid-sort-view-shuttle-buttons {\n  margin: auto;\n}\n\n.rest-grid-sort-view-selected-header1 {\n  text-align: center;\n}\n\n.oj-dbt-data-grid-sort-view-selected-list {\n  overflow: auto;\n}\n\n.oj-dbt-data-grid-sort-view-list-filter {\n  margin: 0.4rem;\n}\n\noj-dbt-data-grid .oj-listview-group-item, oj-dbt-data-grid .oj-listview-item {\n  padding: 0.4rem;\n  min-height: fit-content !important;\n}\n\n/* columns slider */\n\n.oj-dbt-data-grid-columns-view-body {\n    display: flex;\n    flex-direction: row;\n}\n\n.oj-dbt-data-grid-columns-view-body .oj-listview-item {\n  text-transform: uppercase;\n}\n\n.oj-dbt-data-grid-columns-view-order-buttons {\n  margin: auto;\n}\n\n.oj-dbt-data-grid-columns-view-shown-list {\n    overflow: auto;\n}\n\n.oj-dbt-data-grid-columns-view-shuttle-buttons {\n  margin: auto;\n}\n\n.oj-dbt-data-grid-columns-view-hidden-list {\n    overflow: auto;\n}\n\n.oj-dbt-data-grid-columns-view-shown-list-label  {\n    align-self: flex-start !important;\n}\n\n.oj-dbt-data-grid-columns-view-hidden-list-label {\n    align-self: flex-start !important;\n}\n\noj-dbt-data-grid .oj-datagrid-cell.oj-selected.oj-datagrid-selected-top::before {\n  border-top-width: 0px; }\n\noj-dbt-data-grid .oj-datagrid-cell.oj-selected.oj-datagrid-selected-bottom::before {\n  border-bottom-width: 0px; }\n\n.oj-dbt-data-grid-form-label-start  .oj-formlayout-inline-label > .oj-label {\n    text-align: start;\n}\n\n.oj-dbt-data-grid-form-label-start  .oj-user-assistance-inline-container.oj-efficient {\n  min-height: 0.33rem !important;\n}\n\n/* Updatable */\n\n/* Styling on updated row header cells */\nhtml:not([dir=\"rtl\"]) .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-updated:not(.oj-dbt-data-grid-header-row-inserted) {\n  border: solid 1px var(--ojDbtDataGridCellUpdatedBorderColor);\n}\n\nhtml[dir=\"rtl\"] .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-updated:not(.oj-dbt-data-grid-header-row-inserted) {\n  border: solid 1px var(--ojDbtDataGridCellUpdatedBorderColor);\n}\n\n/*\nhtml:not([dir=\"rtl\"]) .oj-datagrid-cell.oj-datagrid-border-vertical-none.oj-dbt-data-grid-cell-updated,\nhtml:not([dir=\"rtl\"]) .oj-datagrid-cell.oj-datagrid-border-horizontal-none.oj-dbt-data-grid-cell-updated{\n    border-right-color:  var(--ojDbtDataGridCellUpdatedBorderColor);\n    border-bottom-color: var(--ojDbtDataGridCellUpdatedBorderColor);\n}\n\nhtml[dir=\"rtl\"] .oj-datagrid-cell.oj-datagrid-border-vertical-none.oj-dbt-data-grid-cell-updated,\nhtml[dir=\"rtl\"] .oj-datagrid-cell.oj-datagrid-border-horizontal-none.oj-dbt-data-grid-cell-updated{\n    border-right-color:  var(--ojDbtDataGridCellUpdatedBorderColor);\n    border-bottom-color: var(--ojDbtDataGridCellUpdatedBorderColor);\n}\n\n.oj-dbt-data-grid-cell-updated {\n  border: solid 1px var(--ojDbtDataGridCellUpdatedBorderColor);\n}\n*/\n\n\n/* Updatable inserted */\n\n/* row header start vertical, top and bottom */\nhtml:not([dir=rtl]) .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-inserted {\n  border-top: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-left: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-top-width: 1px;\n  border-bottom-width: 1px;\n  border-left-width: 1px;\n}\n\nhtml[dir=rtl] .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-inserted {\n  border-top: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-right: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridRowNewHeaderBorderColor);\n  border-top-width: 1px;\n  border-right-width: 1px;\n  border-bottom-width: 1px;\n}\n\n/* end of row vertical */\n.oj-dbt-data-grid-cell-row-last-cell.oj-dbt-data-grid-cell-row-inserted:not([dir=rtl]) {\n  border-right: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n}\n\n.oj-dbt-data-grid-cell-row-last-cell.oj-dbt-data-grid-cell-row-inserted[dir=rtl] {\n  border-left: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n}\n\n/* cell top and bottom */\nhtml[dir=rtl] .oj-datagrid-cell.oj-datagrid-border-vertical-none.oj-dbt-data-grid-cell-row-inserted,\nhtml:not([dir=rtl]) .oj-datagrid-cell.oj-datagrid-border-vertical-none.oj-dbt-data-grid-cell-row-inserted {\n  border-top: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n}\n\n.oj-datagrid-cell.oj-datagrid-border-horizontal-none.oj-dbt-data-grid-cell-row-inserted,\n.oj-datagrid-header-cell.oj-datagrid-border-horizontal-none.oj-dbt-data-grid-cell-row-inserted,\n.oj-datagrid-end-header-cell.oj-datagrid-border-horizontal-none.oj-dbt-data-grid-cell-row-inserted {\n  border-top: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridCellNewBorderColor);\n}\n\n/* sdRestGrid row deleted styles */\n/* row header start vertical, top and bottom */\nhtml:not([dir=rtl]) .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-deleted {\n  border-top: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-left: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-top-width: 1px;\n  border-bottom-width: 1px;\n  border-left-width: 1px;\n}\n\nhtml[dir=rtl] .oj-datagrid-row-header-cell.oj-dbt-data-grid-header-row-deleted {\n  border-top: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-right: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n  border-top-width: 1px;\n  border-right-width: 1px;\n  border-bottom-width: 1px;\n}\n\n/* end of row vertical */\n.oj-dbt-data-grid-cell-row-last-cell.oj-dbt-data-grid-cell-row-deleted:not([dir=rtl]) {\n  border-right: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n}\n\n.oj-dbt-data-grid-cell-row-last-cell.oj-dbt-data-grid-cell-row-deleted[dir=rtl] {\n  border-left: solid 1px var(--ojDbtDataGridRowDeletedHeaderBorderColor);\n}\n\nhtml[dir=rtl] .oj-datagrid-cell.oj-dbt-data-grid-cell-row-deleted,\nhtml:not([dir=rtl]) .oj-datagrid-cell.oj-dbt-data-grid-cell-row-deleted {\n  border-top: solid 1px var(--ojDbtDataGridCellDeletedBorderColor);\n  border-bottom: solid 1px var(--ojDbtDataGridCellDeletedBorderColor);\n}\n\n/* off-canvas sliders *\n/*\noj-dbt-data-grid-off-canvas-content\noj-dbt-data-grid-off-canvas-content-0\noj-dbt-data-grid-off-canvas-content-1\noj-dbt-data-grid-off-canvas-content-2\noj-dbt-data-grid-off-canvas-content-3\noj-dbt-data-grid-off-canvas-content-0\noj-dbt-data-grid-off-canvas-content-1\noj-dbt-data-grid-off-canvas-content-2\n*/\n.dbt-code-viewer {\n    display: flex;\n    justify-content: space-between;\n    position: relative;\n}\n\n.dbt-code-viewer__container--relative {\n    position: relative;\n    background-color: inherit;\n    overflow: auto;\n    height: 100%;\n    width: 100%;\n}\n\n.dbt-code-viewer__container--absolute {\n    position: absolute;\n}\n\n.dbt-code-viewer__content {\n    position: relative;\n    padding: 10px;\n    display: inline-block;\n    width: max-content;\n}\n\n.dbt-code-viewer__container--absolute .dbt-code-viewer__content {\n    white-space: pre;\n    padding: 10px;\n}\n\n\n/* Size */\n\n.dbt-code-viewer__size--inherit {\n    height: 100%;\n    width: 100%;\n}\n\n/* Loading spinner */\n\n.dbt-code-viewer__loading-spinner__container {\n    background-color: inherit;\n    position: absolute;\n}\n\n.dbt-code-viewer__loading-spinner {\n    /* 7px so that the spinner\'s size (7px padding + 16px span + 7px padding) matches with the buttons\' size (30px) */\n    padding: 7px;\n}\n\n/* Actions */\n\n.dbt-code-viewer__actions {\n    background-color: inherit;\n    padding: 10px;\n    position: sticky;\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    align-self: baseline;\n}\n\n.dbt-code-viewer__popup {\n    white-space: pre-wrap;\n}\n\n.dbt-code-viewer__actions--horizontal {\n    /* Both 10px are to take into consideration the padding  */\n    width: calc( 100% - 10px - 10px );\n    flex-direction: row-reverse;\n    /* min-height is for when there are no actions but the loading spinner is active */\n    min-height: 30px;\n}\n\n.dbt-code-viewer__actions--top .dbt-code-viewer__actions {\n    top: 0px;\n}\n\n.dbt-code-viewer__actions--right .dbt-code-viewer__actions {\n    right: 0px;\n}\n\n.dbt-code-viewer__actions--bottom .dbt-code-viewer__actions {\n    bottom: 0px;\n}\n\n.dbt-code-viewer__actions--left .dbt-code-viewer__actions {\n    left: 0px;\n}\n\n.dbt-code-viewer__actions dbt-code-viewer-action > .dbt-code-viewer__action {\n    height: 30px;\n    width: 30px;\n    min-width: 30px;\n    margin-bottom: 0;\n    background-color: inherit !important;\n}\n\n/* Actions scrollbar padding */\n\n.dbt-code-viewer--has-vertical-scrollbar.dbt-code-viewer__actions--right .dbt-code-viewer__actions {\n    /* --scroll-width is the width of the scrollbar */\n    right: var( --scroll-width );\n}\n\n.dbt-code-viewer--has-vertical-scrollbar.dbt-code-viewer__actions--bottom .dbt-code-viewer__actions {\n    /* --scroll-height is the height of the scrollbar */\n    bottom: var( --scroll-height );\n}\n\n.dbt-code-viewer--has-horizontal-scrollbar .dbt-code-viewer__actions--vertical {\n    /* Both 10px are to take into consideration the padding  */\n    /* --scroll-height is the height of the scrollbar */\n    height: fit-content;\n    padding: 0;\n    padding-top: 10px;\n}\n\n.dbt-code-viewer--has-vertical-scrollbar .dbt-code-viewer__actions--horizontal {\n    /* Both 10px are to take into consideration the padding  */\n    /* --scroll-width is the height of the scrollbar */\n    width: calc( 100% - 10px - 10px - var( --scroll-width ) );\n}\n\n/* Inline effects on containers */\n\n.dbt-code-viewer--inline .dbt-code-viewer__content {\n    padding: 0px;\n}\n\n/* Actions position effects on containers */\n\n.dbt-code-viewer__actions--horizontal dbt-code-viewer-action > .dbt-code-viewer__action:not(:last-child) {\n    /* 10px is the space between buttons */\n    margin-left: 10px;\n}\n\n.dbt-code-viewer__actions--vertical dbt-code-viewer-action > .dbt-code-viewer__action:not(:last-child) {\n    /* 10px is the space between buttons */\n    margin-bottom: 10px;\n}\n\n.dbt-code-viewer__actions--top .dbt-code-viewer__container--absolute {\n    /* 50px is to align the absolute container with the bottom of the relative container */\n    height: calc( 100% - 50px );\n    top: 0px;\n    padding-top: 50px;\n}\n\n.dbt-code-viewer__actions--bottom .dbt-code-viewer__container--absolute {\n    /* 50px is to align the absolute container with the bottom of the relative container */\n    height: calc( 100% - 50px );\n    padding-bottom: 50px;\n}\n\n.dbt-code-viewer__actions--top.dbt-code-viewer__size--defined-by-content .dbt-code-viewer__content {\n    /* 50px is the height of the actions section */\n    padding-top: 50px;\n}\n\n.dbt-code-viewer__actions--right.dbt-code-viewer__size--inherit .dbt-code-viewer__content {\n    /* 50px is the width of the actions section */\n    padding-right: 50px;\n}\n\n.dbt-code-viewer__actions--bottom.dbt-code-viewer__size--defined-by-content .dbt-code-viewer__content {\n    /* 50px is the height of the actions section */\n    padding-bottom: 50px;\n}\n\n.dbt-code-viewer__actions--left .dbt-code-viewer__content {\n    /* 50px is the width of the actions section */\n    padding-left: 50px;\n}\n\n/* Theme */\n\n.dbt-code-viewer__theme {\n    font-family: Hack, Consolas, Menlo, Monaco, \"Source Code Pro\",\"Courier New\", Courier, monospace;\n    font-size: 12px;\n}\n\n.dbt-code-viewer__theme--vs {\n    background-color: #FFFFFF;\n}\n\n.dbt-code-viewer__theme--vs-snippet {\n    background-color: rgb(var(--oj-palette-neutral-rgb-10));\n}\n\n.dbt-code-viewer__theme--vs-dark {\n    background-color:#222222;\n}\n\n.dbt-code-viewer__theme--hc-black {\n    background-color: #000000;\n}\n\n/*\nThe background-color for the .dbt-code-viewer__actions could be set with \'inherit\'\nbut for some reason, in Google Chrome, when the dbt-code-viewer has a change in theme,\n.dbt-code-viewer__actions is not updating its background-color.\n\ncolor is specified so that the loading spinner gets it.\n */\n .dbt-code-viewer__theme--vs .dbt-code-viewer__actions,\n .dbt-code-viewer__theme--vs-dark .dbt-code-viewer__actions,\n .dbt-code-viewer__theme--hc-black .dbt-code-viewer__actions {\n    top: 10px;\n    background-color: transparent;\n    color: rgb( 0, 0, 0 );\n    padding: 0;\n    margin: 0;\n    position: sticky;\n    left: calc( 100% - 40px ); /*  The button itself is 30px + the padding spacing which is 10px */\n    width: 30px;\n}\n/* Avoid overlapping with the info button */\n.output-error-item__message {\n    float: left;\n    outline: none;\n    white-space: pre-line;\n    /* 30px is the size of the button and 10px is the padding */\n    width: 100%;\n    box-sizing: border-box;\n}\n\n.output-error-item__plsql-object-position {\n    color: var( --color-site-2-c-1 );\n    white-space: nowrap;\n    text-decoration: underline;\n}\n\n.output-error-item__plsql-object-description {\n    white-space: initial;\n    word-break: break-word;\n}\n\n.output-error-item__plsql-object-position:hover {\n    cursor: pointer;\n    text-decoration: none;\n}\n\n.output-error-item oj-button {\n    height: 30px;\n    width: 30px;\n    margin-bottom: 0;\n    background-color: inherit !important;\n}\n\n.output-error-item__controls {\n    position: absolute;\n    right: 10px;\n}\n\n.output-error-item_button {\n    right: 10px;\n}\n\n.output-error-item__message__popup .oj-popup-content {\n    padding: 0;\n}\n\n.output-error-item-msg {\n    background: transparent !important;\n    color: red !important;\n    line-height: 30px;\n    padding: 0 8px;\n}\n.output-msg.output-msg--error .message { \n    display: flex;\n    padding: 0 8px;\n    line-height: 30px\n}\n\n.output-error-item__message__popup .dbt-code-viewer__actions--vertical {\n    height: 30px;\n}\n\n.output-error-item__message__popup__content {\n    min-width: 350px; \n    max-height: 600px; \n    max-width: 700px; \n    user-select: text; \n    overflow: auto;\n}\n\n.output-error-item-viewer {\n    display: inline-flex;\n    min-width: inherit;\n}\n\n.output-error-item-line-numbers {\n    width: 20px;\n    text-align: right;\n    font-family: Hack, Menlo, Monaco, \"Courier New\", monospace;\n    font-size: 12px;\n    padding-top: 10px!important;\n}\n\n.output-error-item-line-numbers span::before {\n    display: block;\n    color: #333333;\n}\n\n.output-error-item-code-viewer {\n    width: 100%; \n    user-select: text; \n    overflow: auto;\n}.query_result-tab-panel {\n    height: 100%;\n}\n\n.query-result__error-container {\n    height: 0;\n    overflow: auto;\n    flex-grow: 1;\n    position: relative;\n}.sql-history-controls {\n    flex-wrap: wrap-reverse;\n}\n\n.gap-2 {\n    gap: 0.5rem;\n}\n\n.gap-4 {\n    gap: 1rem;\n}\n\n.fill-container {\n    width: 100%;\n    height: 100%;\n}\n\n.statement-details__snippet {\n    width: 100%;\n    border: 1px solid rgb(var(--oj-palette-neutral-rgb-40));\n    background-color: rgb(var(--oj-palette-neutral-rgb-10));\n    overflow: auto;\n}\n\n.statement-details__snippet-dark {\n    width: 100%;\n    overflow: auto;\n}\n\n/* Overriding the background color added by oj-table-container without changing the JET class */\n.table-container {\n    background-color: var( --oj-collection-bg-color ) !important;\n}\n.oj-tab-bar {\n    visibility: visible;\n}\n\n.hover-mouse {\n    cursor: pointer;\n}\n\n.script-result {\n    max-height: 100%;\n    flex-wrap: unset;\n    /* Needed to scroll at the end during each script run */\n    overflow: auto;\n}\n\n\n\n/* Needed to match SDW sizes for the buttons */\n.button-size-small {\n    height: 30px;\n    width: 30px;\n}\n\n.script-result-container {\n    font-family: Hack, Consolas, Menlo, Monaco, \"Source Code Pro\", \"Courier New\", Courier, monospace;\n    font-size: smaller;\n    flex: 1;\n}\n\n\n.icons-container {\n    position: sticky;\n    height: fit-content;\n    top: 10px;\n    right: 10px;\n    background-color: inherit;\n    gap: 5px;\n    /* Flex-wrap added by OJET messes up the direction of the buttons */\n    flex-wrap: unset;\n}\n\n.result-container {\n    flex-grow: 1;\n    position: relative;\n    width: 100%;\n    height: 100%;\n}\n\n.script-output-wrapper {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n}\n\n.code-and-icons-container {\n    background-color: inherit;\n    border-bottom: 1px solid var( --oj-panel-border-color );\n    position: \'relative\';\n    width: \'100%\';\n    flex-wrap: unset;\n}\n\n.script-result-wrapper {\n    max-height: 100%;\n    overflow: hidden;\n}\n\n.script-output-result-container,\n.script-container {\n    height: 100%;\n}\n\n.icons-toolbar {\n    padding-right: 5px;\n    border-bottom: 1px solid var( --oj-panel-border-color );\n}.dbms-output {\n    width: 100%;\n    height: 100%;\n    flex-grow: 1;\n    position: relative;\n}\n\n.dbms-output-wrapper {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 0;\n    bottom: 0;\n}\n\n.dbms-result {\n    height: auto;\n    overflow: auto;\n    /*  without adding this calc, a part of the last dbms output is becomes hidden.\n        It is the same approach folowed in SDW */\n    height: calc( 100% - 45px );\n    width: 100%;\n}\n\n.output-icons-container {\n    gap: 5px;\n}\n.output-icons-container oj-surrogate {\n    /* used to avoid layout shift when the \'Copied!\' oj-popup is shown */\n    position: absolute;\n}\n.icon-toolbar {\n    padding-right: 5px;\n}\n\n.dbms-result-container {\n    border-left: 0px;\n    border-right: 0px;\n}\n\n.app-Container > .oj-web-applayout-content {\n    min-height: 0;\n    background-color: var( --oj-core-bg-color-content );\n\n}\n\n.full-height {\n    width: 100%;\n    height: 100%;\n    background-color: var( --color-site-2 );\n    display: -webkit-box;\n    display: -ms-flexbox;\n    display: flex;\n    -webkit-box-orient: vertical;\n    -webkit-box-direction: normal;\n    -ms-flex-direction: column;\n    flex-direction: column;\n    -webkit-box-pack: start;\n    -ms-flex-pack: start;\n    justify-content: flex-start;\n    -webkit-box-align: stretch;\n    -ms-flex-align: stretch;\n    align-items: stretch;\n    -ms-flex-line-pack: stretch;\n    align-content: stretch;\n}\n\n.embedded-playground {\n    height: 100%;\n    background-color: var( --color-site-2, RGB( var( --oj-palette-neutral-rgb-30 ) ) );\n}\n\n.worksheet .ui-layout-west {\n    margin-right: 5px;\n    display: inline-block;\n    height: 100%;\n    width: 300px;\n}\n\n.worksheet .ui-layout-center {\n    margin-left: 5px;\n    margin-right: 5px;\n    display: inline-block;\n    height: 100%;\n    width: calc(100% - 700px);\n}\n\n.worksheet .ui-layout-right {\n    height: 100%;\n    width: calc(100% - 300px);\n}\n\n.worksheet .ui-layout-east {\n    margin-left: 5px;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n}\n\n.worksheet #library-panel {\n    height: inherit;\n}\n\n.worksheet #worksheet-wrapper {\n    height: inherit;\n    min-height: 0;\n}\n\n.worksheet .oj-web-applayout-content {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow: auto;\n}\n\n@media (max-width: 1100px) {\n    .worksheet {\n        overflow-x: auto;\n    }\n    \n    .worksheet .ui-layout-west {\n        margin-right: 5px;\n        display: inline-block;\n        height: 100%;\n        width: 300px !important;\n    }\n\n    .worksheet .ui-layout-center {\n        margin-left: 5px;\n        margin-right: 5px;\n        display: inline-block;\n        height: 100%;\n        width: calc(100% -355px) !important;\n    }\n\n    .worksheet .ui-layout-right {\n        height: 100%;\n        width: 100% !important;\n    }\n\n    .worksheet .ui-layout-east {\n        margin-left: 5px;\n        width: 355px !important;\n        height: 100%;\n        display: flex;\n        flex-direction: column;\n    }\n}\n\n@media (max-width: 705px) {\n    .worksheet .ui-layout-west {\n        margin-right: 5px;\n        display: inline-block;\n        height: 100%;\n        width: 100% !important;\n    }\n\n    .worksheet .ui-layout-center {\n        margin-left: 5px;\n        margin-right: 5px;\n        display: inline-block;\n        height: 100%;\n        width: 100% !important;\n    }\n\n    .worksheet .ui-layout-right {\n        height: 100%;\n        width: 100% !important;\n    }\n\n    .worksheet .ui-layout-east {\n        margin-left: 5px;\n        width: 100% !important;\n        height: 100%;\n        display: flex;\n        flex-direction: column;\n        z-index: 100;\n        background-color: var( --color-site-2, #FFFFFF );\n    }\n}\n\n.worksheet .oj-tabs {\n    border-radius: 2px;\n}\n\n.worksheet dbt-code-playground {\n    border: 1px solid var( --color-site-2, #e5e6e6 );\n}\n\n.worksheet-bottom-tabs {\n    background-color: var( --oj-core-bg-color-content );\n    color: var( --oj-core-text-color-primary );\n}\n\n.footer-mobile {\n    background-color: var( --oj-core-bg-color-content );\n    color: var( --oj-core-text-color-primary );\n}\n\n.footer-mobile a {\n    color: inherit;\n}\n/**! hopscotch\n* Copyright (c) 2020, Oracle and/or its affiliates\n* =========================================================================\n* == NOTICE file corresponding to the section 4 b of the Apache License, ==\n* == Version 2.0, this file was modified and/or includes software        ==\n* == developed by Oracle Corp.                                           ==\n* =========================================================================\n*\n* Copyright 2017 LinkedIn Corp. All rights reserved.\n*\n* Licensed under the Apache License, Version 2.0 (the \"License\");\n* you may not use this file except in compliance with the License.\n* You may obtain a copy of the License at\n*\n*     http://www.apache.org/licenses/LICENSE-2.0\n*\n* Unless required by applicable law or agreed to in writing, software\n* distributed under the License is distributed on an \"AS IS\" BASIS,\n* WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n* See the License for the specific language governing permissions and\n* limitations under the License.\n*/\n.animated{-webkit-animation-fill-mode:both;-moz