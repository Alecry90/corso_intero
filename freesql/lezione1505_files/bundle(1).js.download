define('text!live-sql/components/slider-manager/Slider.html',[],function () { return '<div id="oj-dbt-drawer-id" style="height: 100%;">\n  <div :class="[[{\'oj-drawer-popup-flex-row oj-drawer-popup-container\': title }]]">\n    <div :class="[[{\'oj-drawer-popup-flex-column\': title }]]">\n      <oj-bind-if test="[[title]]">\n        <div class="oj-drawer-popup-flex-row-fixed oj-drawer-popup-header">\n          <h3>\n            <oj-bind-if test="[[titleIcon]]">\n              <oj-bind-if test="[[titleIcon().img]]">\n                <img :src="[[titleIcon().img.src]]"\n                      :width="[[titleIcon().img.width]]" \n                      :height="[[titleIcon().img.height]]"\n                      :class="[[titleIcon().img.classString]]">\n              </oj-bind-if>\n              <oj-bind-if test="[[titleIcon().span]]">\n                <span :class="[[titleIcon().span.classString]]"></span>\n              </oj-bind-if>\n              <oj-bind-if test="[[titleIcon().div]]">\n                <div :class="[[titleIcon().div.classString]]" style="display: inline-block"></div>\n              </oj-bind-if>\n            </oj-bind-if>\n            <oj-bind-text value="[[title]]"></oj-bind-text>\n          </h3>\n        </div>\n      </oj-bind-if>\n      <div id="slider-contents" :class="[[{\'oj-drawer-popup-content\': title }]]">\n        <oj-module config="[[ drawerConfig ]]"></oj-module>\n      </div>\n    </div>\n  </div>\n</div>\n';});

