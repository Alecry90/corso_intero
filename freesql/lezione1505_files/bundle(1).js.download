lf-center oj-sm-flex-1">\n                            <oj-bind-if test="[[ properties.titleText ]]">\n                                <oj-bind-dom config="[[ titleConfig ]]">\n                                </oj-bind-dom>\n                            </oj-bind-if>\n                        </div>\n\n                        <div class="dbt-panel__buttonset-controls-container oj-flex oj-sm-flex-0 oj-sm-align-items-center oj-sm-justify-content-flex-end">\n                            <div id="slot__beforeControls">\n                                <oj-bind-slot name="beforeControls"></oj-bind-slot>\n                            </div>\n\n                            <oj-buttonset-one\n                                class="oj-sm-margin-1x-start"\n                                value="{{ selectedTarget }}"\n                                display="[[ properties.layout.options && properties.layout.options.display ]]">\n                                <oj-bind-for-each data="[[ properties.targets ]]">\n                                    <template>\n                                        <oj-option value="[[ $current.data.id + \'-tab\' ]]">\n                                            <span slot="startIcon" :class=\'[[ $current.data.icon ]]\'></span>\n                                            <span>\n                                                <oj-bind-text value="[[ $current.data.label ]]"></oj-bind-text>\n                                            </span>\n                                        </oj-option>\n                                    </template>\n                                </oj-bind-for-each>\n                            </oj-buttonset-one>\n\n                            <div id="slot__afterControls">\n                                <oj-bind-slot name="afterControls"></oj-bind-slot>\n                            </div>\n                        </div>\n                    </div>\n                </oj-bind-if>\n            </div>\n        </oj-bind-i