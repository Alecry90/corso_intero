define('text!live-sql/components/object-browser-slider/modules/RESTGrid.html',[],function () { return '<div class="oj-sm-flex-1 oj-flex oj-sm-flex-direction-column">\n    <div class="oj-flex-bar oj-sm-flex-initial oj-padding-end">\n        <oj-button\n            id="browser-restgrid-slider-refresh-button"\n            class="oj-flex-bar-end"\n            on-oj-action="[[ $module[\'refresh\'] ]]"\n            :aria-label="Refresh"\n            :title="Refresh"\n            chroming="half"\n            display="icons"\n            disabled="[[ $module[ \'refreshDisabled\' ] ]]">\n            <span>\n                <oj-bind-text value="Refresh"></oj-bind-text>\n            </span>\n            <span slot="startIcon" class="fa oj-ux-ico-refresh"></span>\n        </oj-button>\n    </div>\n    <oj-dbt-data-grid\n        :id="[[ $module[\'browserRestGridId\']() ]]"\n        class="oj-sm-flex-1 browser-grid"\n        style="width: 100%; "\n        data="[[ $module[\'data\'] ]]"\n        dbt.has-visualisation-button="[[ \'enable\' ]]"\n        dbt.has-hover-popup="[[ \'enable\' ]]"\n        on-oj-dbt-off-canvas-active="[[ $module[\'ojOffCanvasActive\'] ]]">\n    </oj-dbt-data-grid>\n</div>\n';});


define('text!live-sql/components/object-browser-slider/modules/DataGrid.html',[],function () { return '<div class="oj-sm-flex-1 oj-flex oj-sm-flex-direction-column">\n\n    <oj-toolbar class="oj-typography-body-sm oj-sm-flex-initial oj-padding-end oj-flex-bar" style="">\n        <oj-button\n            class=""\n            chroming="half"\n            display="all"\n            disabled="[[ $module[\'insertRowDisabled\'] ]]"\n            on-oj-action="[[ $module[\'insertRow\'] ]]">\n            <span slot="startIcon" :class="[[ {\n                          \'fa\': true,\n                          \'oj-ux-ico-add-level\': true,\n                          \'fam-plus\': !$module[\'insertRowDisabled\'](),\n                          \'fam-is-success\': !$module[\'insertRowDisabled\']()\n                        } ]]"></span>\n            <span><oj-bind-text value="Insert"></oj-bind-text></span>\n        </oj-button>\n        <oj-button\n            class=""\n            chroming="half"\n            display="all"\n            disabled="[[ $module[\'deleteRowsDisabled\'] ]]"\n            on-oj-action="[[ $module[\'deleteRows\'] ]]">\n            <span slot="startIcon" :class="[[ {\n                          \'fa\': true,\n                          \'oj-ux-ico-trash\': true,\n                          \'fam-x\': !$module[\'deleteRowsDisabled\'](),\n                          \'fam-is-danger\': !$module[\'deleteRowsDisabled\']()\n                        } ]]"></span>\n            <span><oj-bind-text value="Delete Selected"></oj-bind-text></span>\n        </oj-button>\n        <span role="separator" aria-orientation="vertical" class="oj-toolbar-separator"></span>\n        <oj-button\n            class=""\n            chroming="half"\n            display="all"\n            disabled="[[ $module[\'commitChangesDisabled\'] ]]"\n            on-oj-action="[[ $module[\'onCommitChanges\'] ]]">\n            <span slot="startIcon" :class="[[ {\n                          \'fa\': true,\n 