define('text!live-sql/components/dbt-code-viewer/view.html',[],function () { return '<oj-bind-if test="[[ viewElement ]]">\n    <div :id="[[ ID ]]" :class="[[ classesString() ]]" :style="[[ specificStyle ]]">\n        <oj-bind-if test="[[ layeredContainers() ]]">\n            <div :id="[[ RELATIVE_CONTAINER_ID ]]" class="dbt-code-viewer__container--relative">\n                <div :id="[[ ABSOLUTE_CONTAINER_ID ]]" class="dbt-code-viewer__container--absolute">\n                    <oj-bind-dom config="[[ viewElement ]]"></oj-bind-dom>\n                </div>\n                <oj-bind-if test="[[ showActions() ]]">\n                    <div :id="[[ ACTIONS_ID ]]" :class="[[ actionsClassesString() ]]">\n                        <oj-bind-for-each data="[[ actions ]]">\n                            <template>\n                                <dbt-code-viewer-action\n                                    component-type="[[ $current.data.componentType ]]"\n                                    button-id= "[[ $current.data.btnID ]]"\n                                    action="[[ $current.data.action ]]"\n                                    label="[[ $current.data.label ]]"\n                                    chroming="[[ $current.data.chroming ]]"\n                                    icon="[[ $current.data.icon ]]"\n                                    popup-id="[[ $current.data.popupID ]]"\n                                    popup-text="[[ $current.data.popupText ]]"\n                                    options="[[ $current.data.options ]]">\n                                </dbt-code-viewer-action>\n                            </template>\n                        </oj-bind-for-each>\n                        <oj-bind-if test="[[ isLoading ]]">\n                            <div class="dbt-code-viewer__loading-spinner__container">\n                                <span aria-hidden="true"  class="fa fa-circle-7-8 fa-anim-spin dbt-code-viewer__loading-spinner"></span>\n                            </div>\n                        </oj-bind-if>\n                    </div>\n                </oj-bind-if>\n            </div>\n        </oj-bind-if>\n        <oj-bind-if test="[[ !layeredContainers() ]]">\n            <oj-bind-dom config="[[ viewElement ]]"></oj-bind-dom>\n            <oj-bind-if test="[[ showActions() ]]">\n                <div :id="[[ ACTIONS_ID ]]" :class="[[ actionsClassesString() ]]">\n                    <oj-bind-for-each data="[[ actions ]]">\n                        <template>\n                            <dbt-code-viewer-action\n                                component-type="[[ $current.data.componentType ]]"\n                                button-id= "[[ $current.data.btnID ]]"\n                                action="[[ $current.data.action ]]"\n                                label="[[ $current.data.label ]]"\n                                chroming="[[ $current.data.chroming ]]"\n                                icon="[[ $current.data.icon ]]"\n                                popup-id="[[ $current.data.popupID ]]"\n                                popup-text="[[ $current.data.popupText ]]"\n                                options="[[ $current.data.options ]]">\n                            </dbt-code-viewer-action>\n                        </template>\n                    </oj-bind-for-each>\n                    <oj-bind-if test="[[ isLoading ]]">\n                        <div class="dbt-code-viewer__loading-spinner__container">\n                            <span aria-hidden="true"  class="fa fa-circle-7-8 fa-anim-spin dbt-code-viewer__loading-spinner"></span>\n                        </div>\n                    </oj-bind-if>\n                </div>\n            </oj-bind-if>\n        </oj-bind-if>\n    </div>\n</oj-bind-if>\n';});

