# Copiare in .env.local solo dopo avere creato la Web App Firebase.
# La configurazione Web Firebase identifica l'app: non contiene credenziali Admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080
# Solo test isolati: emulatore Firestore senza cambiare il servizio Auth.
VITE_FIRESTORE_EMULATOR_HOST=
# In sviluppo senza Firebase viene letto public/data/catalog.json, senza prodotti inventati.
# La modalità demo è solo per anteprime esplicite e non è pubblicabile.
VITE_CATALOG_MODE=auto
