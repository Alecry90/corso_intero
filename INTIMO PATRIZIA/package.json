{
  "name": "intimopatrizia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IntimoPatrizia: sito e catalogo Firebase per Intimo Patrizia, Bari",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:rules": "node --test tests/firestore-rules.test.js",
    "test:api": "node --test functions/test/*.test.js",
    "firebase:emulators": "firebase emulators:start --project demo-intimopatrizia",
    "firebase:emulators:firestore": "node scripts/start-firestore-emulator.mjs",
    "firebase:status": "node scripts/check-cloud.mjs",
    "firebase:deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.1",
    "firebase-tools": "^15.34.0",
    "vite": "8.3.4"
  }
}
